# Database (PostgreSQL for both local dev and production)
# Example (local Postgres):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockroom?schema=public"
# Example (hosted, e.g. Neon / Supabase / RDS):
#   DATABASE_URL="postgresql://user:password@host:5432/stockroom?schema=public&sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockroom?schema=public"
#
# Vercel + Neon (Marketplace) auto-injects POSTGRES_* variables instead of
# DATABASE_URL. The app aliases them at startup, so a production deploy with
# only the Neon integration attached will work as-is. You do NOT need to set
# DATABASE_URL manually when any of these are present:
#   POSTGRES_PRISMA_URL   # pooled URL, preferred for Prisma
#   POSTGRES_URL          # pooled URL (fallback)
#   POSTGRES_URL_NON_POOLING / DATABASE_URL_UNPOOLED  # direct URL (migrations)
# Resolution order: DATABASE_URL > POSTGRES_PRISMA_URL > POSTGRES_URL.

# Session cookie signing secret (any long random string)
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used by Stripe redirects & webhook)
APP_URL="http://localhost:3000"

# Stripe (test keys are fine for local development)
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Recurring price ID for the Stockroom Pro plan ($29/mo)
STRIPE_PRO_PRICE_ID="price_replace_me"
