# Database — Postgres (Neon in production on Vercel)
# Use a Postgres connection string for both local dev and production.
# Neon example (production): postgresql://user:password@ep-xxxx.neon.tech/stockroom?sslmode=require
# Local Postgres example: postgresql://postgres:postgres@localhost:5432/stockroom?schema=public
DATABASE_URL="postgresql://user:password@host:5432/stockroom?schema=public"

# Session cookie signing secret (any long random string)
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used by Stripe redirects & webhook)
APP_URL="http://localhost:3000"

# Stripe (test keys are fine for local development)
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Recurring price ID for the Stockroom Pro plan ($29/mo)
STRIPE_PRO_PRICE_ID="price_replace_me"
