# Database (SQLite for local dev; Postgres in production)
# Local: file-based SQLite
DATABASE_URL="file:./prisma/dev.db"
# Production (Postgres) example:
# DATABASE_URL="postgresql://user:password@host:5432/stockroom?schema=public"

# Session cookie signing secret (any long random string)
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used by Stripe redirects & webhook)
APP_URL="http://localhost:3000"

# Stripe (test keys are fine for local development)
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Recurring price ID for the Stockroom Pro plan ($29/mo)
STRIPE_PRO_PRICE_ID="price_replace_me"
